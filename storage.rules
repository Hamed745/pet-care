rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /products/{adminUid}/{fileName} {
      // Product photos are public so shoppers can view them in the storefront.
      allow read: if true;

      // Only the signed-in administrator may upload to their own folder.
      allow create, update: if request.auth != null
        && request.auth.uid == adminUid
        && request.auth.token.petcareAdmin == true
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');

      // An administrator may delete only files from their own folder.
      allow delete: if request.auth != null
        && request.auth.uid == adminUid
        && request.auth.token.petcareAdmin == true;
    }
  }
}
