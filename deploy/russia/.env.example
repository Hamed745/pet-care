# Deployment target. Buy or use an already owned domain, set its A record to this VPS.
SITE_DOMAIN=petcare.example.ru

# Web app Firebase settings: only public VITE_ values go into the browser build.
VITE_FIREBASE_API_KEY=your-firebase-web-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
VITE_FIREBASE_MEASUREMENT_ID=
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=your-app-check-site-key
VITE_2GIS_MAP_KEY=your-map-tiles-key
VITE_FIREBASE_VAPID_KEY=

# Backend Google Cloud project must match the web app's Firebase project.
FIREBASE_PROJECT_ID=your-project-id
# Private 2GIS Places key: never use a VITE_ prefix here.
DGIS_PLACES_KEY=your-server-side-places-key

# Optional private product-image storage credentials.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
# Never paste the Firebase service account JSON here; use ./secrets/firebase-service-account.json.
